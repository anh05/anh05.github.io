---
/* Author: DA Nguyen */
// Email link with light obfuscation: the address never appears verbatim in
// the HTML. The "@" is drawn by CSS, so the visible text is final from the
// first paint (no layout shift); a script adds the mailto: link from a
// reversed data attribute.
import { profile } from '../data/profile';

const { user, domain } = profile.email;
const reversed = [...`${user}|${domain}`].reverse().join('');
---

<a class="email" data-mail={reversed}>{user}<span class="email-at" aria-hidden="true"></span><span class="visually-hidden"> at </span>{domain}</a>

<style>
  /* The address is split into several nodes; keep them flush in flex rows. */
  .email {
    gap: 0;
  }

  .email-at::before {
    content: '@';
  }
</style>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-mail]')) {
    const [user, domain] = [...(link.dataset.mail ?? '')].reverse().join('').split('|');
    if (user && domain) link.href = `mailto:${user}@${domain}`;
  }
</script>
