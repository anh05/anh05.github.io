---
/* Author: DA Nguyen */
// One publication: citation, DOI / code / package badges and BibTeX copy.
// `data-type` is used by the CSS-only filter on /publications.
import type { CollectionEntry } from 'astro:content';
import { toBibtex } from '../lib/bibtex';
import { displayAuthor, isSelf } from '../lib/format';

interface Props {
  pub: CollectionEntry<'publications'>;
  /** Show the copy-BibTeX button. */
  bibtex?: boolean;
}

const { pub, bibtex = true } = Astro.props;
const d = pub.data;
const typeLabel = { thesis: 'PhD thesis', journal: 'Journal', conference: 'Conference' }[d.type];
const inReview = d.status === 'in-review';
const details = [d.volume && `vol. ${d.volume}`, d.pages && `pp. ${d.pages}`].filter(Boolean).join(', ');
---

<article class="pub" id={pub.id} data-type={d.type}>
  <p class="pub-title">{d.title}</p>
  <p class="pub-authors">
    {
      d.authors.map((author, i) => (
        <>
          {isSelf(author) ? <strong>{displayAuthor(author)}</strong> : displayAuthor(author)}
          {i < d.authors.length - 1 && ', '}
        </>
      ))
    }
  </p>
  <p class="pub-venue">
    {inReview ? 'Manuscript in review' : <em>{d.venue}</em>}
    {details && `, ${details}`}
    {`, ${d.year}.`}
  </p>
  <ul class="badges" aria-label="Publication links">
    <li><span class="badge badge-label">{typeLabel}</span></li>
    {inReview && <li><span class="badge badge-review">In review</span></li>}
    {
      d.doi && (
        <li>
          <a class="badge" href={`https://doi.org/${d.doi}`} target="_blank" rel="noopener">
            DOI<span class="visually-hidden"> for {d.title}</span>
          </a>
        </li>
      )
    }
    {
      d.code && (
        <li>
          <a class="badge" href={d.code} target="_blank" rel="noopener">
            Code<span class="visually-hidden"> for {d.title}</span>
          </a>
        </li>
      )
    }
    {
      d.package && (
        <li>
          <a class="badge" href={d.package} target="_blank" rel="noopener">
            Package<span class="visually-hidden"> for {d.title}</span>
          </a>
        </li>
      )
    }
    {
      bibtex && (
        <li class="no-print">
          <button class="badge copy-bibtex" type="button" data-bibtex={toBibtex(pub)}>
            <span class="copy-label">Copy BibTeX</span>
            <span class="visually-hidden"> for {d.title}</span>
          </button>
        </li>
      )
    }
  </ul>
</article>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button.copy-bibtex')) {
    const label = button.querySelector('.copy-label');
    button.addEventListener('click', async () => {
      const text = button.dataset.bibtex ?? '';
      try {
        await navigator.clipboard.writeText(text);
        if (label) label.textContent = 'Copied ✓';
      } catch {
        // Clipboard API unavailable (e.g. insecure context): show the entry instead.
        window.prompt('Copy the BibTeX entry:', text);
      }
      setTimeout(() => label && (label.textContent = 'Copy BibTeX'), 1600);
    });
  }
</script>
