---
/* Author: DA Nguyen */
// xAutoML deployment architecture as inline SVG. A wide layout for desktop
// and a stacked layout for narrow screens; only one is displayed at a time.
// Colours come from the site's design tokens, so both themes work.
---

<figure class="arch">
  <svg class="arch-wide" viewBox="0 0 940 300" role="img" aria-labelledby="arch-wide-title arch-wide-desc">
    <title id="arch-wide-title">xAutoML deployment architecture</title>
    <desc id="arch-wide-desc">
      Developer pushes to GitHub Actions, which publishes images to GHCR; a self-hosted runner deploys the web and
      database containers. Users reach the web container through a Cloudflare Tunnel.
    </desc>
    <defs>
      <marker id="arch-wide-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="arch-head"></path>
      </marker>
    </defs>

    <g class="arch-node"><rect x="20" y="20" width="190" height="60" rx="6"></rect><text x="115" y="46" class="arch-title">Developer</text><text x="115" y="66" class="arch-sub">git push</text></g>
    <g class="arch-node"><rect x="260" y="20" width="190" height="60" rx="6"></rect><text x="355" y="46" class="arch-title">GitHub Actions</text><text x="355" y="66" class="arch-sub">build images</text></g>
    <g class="arch-node"><rect x="500" y="20" width="190" height="60" rx="6"></rect><text x="595" y="46" class="arch-title">GHCR</text><text x="595" y="66" class="arch-sub">versioned images</text></g>
    <g class="arch-node"><rect x="740" y="20" width="190" height="60" rx="6"></rect><text x="835" y="46" class="arch-title">Self-hosted runner</text><text x="835" y="66" class="arch-sub">pull · deploy</text></g>

    <path class="arch-edge" d="M210 50 H256" marker-end="url(#arch-wide-arrow)"></path>
    <path class="arch-edge" d="M450 50 H496" marker-end="url(#arch-wide-arrow)"></path>
    <path class="arch-edge" d="M690 50 H736" marker-end="url(#arch-wide-arrow)"></path>
    <path class="arch-edge" d="M835 80 V126" marker-end="url(#arch-wide-arrow)"></path>

    <rect class="arch-group" x="500" y="130" width="430" height="150" rx="8"></rect>
    <text x="516" y="152" class="arch-label">Docker Compose host</text>
    <g class="arch-node"><rect x="520" y="170" width="180" height="90" rx="6"></rect><text x="610" y="210" class="arch-title">web</text><text x="610" y="230" class="arch-sub">Flask app</text></g>
    <g class="arch-node"><rect x="730" y="170" width="180" height="90" rx="6"></rect><text x="820" y="210" class="arch-title">db</text><text x="820" y="230" class="arch-sub">MySQL</text></g>
    <path class="arch-link" d="M700 215 H730"></path>

    <g class="arch-node"><rect x="260" y="185" width="190" height="60" rx="6"></rect><text x="355" y="211" class="arch-title">Cloudflare Tunnel</text><text x="355" y="231" class="arch-sub">HTTPS · no open ports</text></g>
    <g class="arch-node"><rect x="20" y="185" width="190" height="60" rx="6"></rect><text x="115" y="211" class="arch-title">Users</text><text x="115" y="231" class="arch-sub">browser</text></g>
    <path class="arch-edge" d="M210 215 H256" marker-end="url(#arch-wide-arrow)"></path>
    <path class="arch-edge" d="M450 215 H516" marker-end="url(#arch-wide-arrow)"></path>
  </svg>

  <svg class="arch-tall" viewBox="0 0 320 690" role="img" aria-labelledby="arch-tall-title arch-tall-desc">
    <title id="arch-tall-title">xAutoML deployment architecture</title>
    <desc id="arch-tall-desc">
      Developer pushes to GitHub Actions, which publishes images to GHCR; a self-hosted runner deploys the web and
      database containers. Users reach the web container through a Cloudflare Tunnel.
    </desc>
    <defs>
      <marker id="arch-tall-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="arch-head"></path>
      </marker>
    </defs>

    <g class="arch-node"><rect x="40" y="10" width="240" height="56" rx="6"></rect><text x="160" y="34" class="arch-title">Developer</text><text x="160" y="54" class="arch-sub">git push</text></g>
    <g class="arch-node"><rect x="40" y="96" width="240" height="56" rx="6"></rect><text x="160" y="120" class="arch-title">GitHub Actions</text><text x="160" y="140" class="arch-sub">build images</text></g>
    <g class="arch-node"><rect x="40" y="182" width="240" height="56" rx="6"></rect><text x="160" y="206" class="arch-title">GHCR</text><text x="160" y="226" class="arch-sub">versioned images</text></g>
    <g class="arch-node"><rect x="40" y="268" width="240" height="56" rx="6"></rect><text x="160" y="292" class="arch-title">Self-hosted runner</text><text x="160" y="312" class="arch-sub">pull · deploy</text></g>

    <path class="arch-edge" d="M160 66 V92" marker-end="url(#arch-tall-arrow)"></path>
    <path class="arch-edge" d="M160 152 V178" marker-end="url(#arch-tall-arrow)"></path>
    <path class="arch-edge" d="M160 238 V264" marker-end="url(#arch-tall-arrow)"></path>
    <path class="arch-edge" d="M160 324 V350" marker-end="url(#arch-tall-arrow)"></path>

    <rect class="arch-group" x="10" y="354" width="300" height="150" rx="8"></rect>
    <text x="24" y="376" class="arch-label">Docker Compose host</text>
    <g class="arch-node"><rect x="24" y="390" width="130" height="96" rx="6"></rect><text x="89" y="432" class="arch-title">web</text><text x="89" y="452" class="arch-sub">Flask app</text></g>
    <g class="arch-node"><rect x="166" y="390" width="130" height="96" rx="6"></rect><text x="231" y="432" class="arch-title">db</text><text x="231" y="452" class="arch-sub">MySQL</text></g>
    <path class="arch-link" d="M154 438 H166"></path>

    <g class="arch-node"><rect x="40" y="540" width="240" height="56" rx="6"></rect><text x="160" y="564" class="arch-title">Cloudflare Tunnel</text><text x="160" y="584" class="arch-sub">HTTPS · no open ports</text></g>
    <g class="arch-node"><rect x="40" y="626" width="240" height="56" rx="6"></rect><text x="160" y="650" class="arch-title">Users</text><text x="160" y="670" class="arch-sub">browser</text></g>
    <path class="arch-edge" d="M160 626 V600" marker-end="url(#arch-tall-arrow)"></path>
    <path class="arch-edge" d="M89 540 V490" marker-end="url(#arch-tall-arrow)"></path>
  </svg>

  <figcaption>
    Top: delivery — each push is built in GitHub Actions, published to GHCR as a versioned image, and
    deployed by a self-hosted runner. Bottom: requests — users reach the web container through a Cloudflare Tunnel.
  </figcaption>
</figure>

<style>
  .arch {
    margin: 0;
  }

  .arch svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .arch-wide {
    display: none !important;
  }

  .arch-tall {
    max-width: 22rem;
    margin-inline: auto;
  }

  @media (min-width: 44rem) {
    /* Break out of the narrow text column so the labels stay legible. */
    .arch {
      width: min(60rem, calc(100vw - 2 * var(--gutter)));
      margin-left: 50%;
      transform: translateX(-50%);
    }

    .arch figcaption {
      max-width: var(--measure);
      margin-inline: auto;
    }

    .arch-wide {
      display: block !important;
    }

    .arch-tall {
      display: none !important;
    }
  }

  .arch-node rect {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }

  .arch-group {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
    stroke-width: 1;
    stroke-dasharray: 5 4;
  }

  .arch-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    fill: var(--color-text-strong);
    text-anchor: middle;
  }

  .arch-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-muted);
    text-anchor: middle;
  }

  .arch-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    fill: var(--color-accent);
  }

  .arch-edge {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }

  .arch-link {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.5;
  }

  .arch-head {
    fill: var(--color-accent);
  }

  figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media print {
    .arch-wide {
      display: block !important;
    }

    .arch-tall {
      display: none !important;
    }
  }
</style>
