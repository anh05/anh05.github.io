---
/* Author: DA Nguyen */
// Page shell: head metadata, theme bootstrap, header navigation and footer.
import '@fontsource-variable/source-serif-4/wght.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { fullHeadline, profile, profileLinks } from '../data/profile';
import { getNav } from '../lib/site';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  type?: 'website' | 'profile' | 'article';
}

const { title, description = `${profile.name} — ${fullHeadline}.`, type } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} — ${profile.headline}`;
const nav = await getNav();
const path = Astro.url.pathname.replace(/\/?$/, '/');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121413" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={fullTitle} description={description} type={type} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">{profile.name}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {year} {profile.name} · {profile.location}</p>
        <ul aria-label="Profiles">
          {
            profileLinks.map((link) => (
              <li>
                <a href={link.url} rel="me noopener" target="_blank">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
  </body>
</html>
