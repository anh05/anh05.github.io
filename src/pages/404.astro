---
/* Author: DA Nguyen */
// Not-found page (GitHub Pages serves dist/404.html automatically).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist.">
  <div class="container narrow page">
    <p class="eyebrow">Error 404</p>
    <h1 style="margin-top: var(--space-3)">Page not found</h1>
    <p class="lead muted" style="margin-top: var(--space-4)">
      The page you are looking for does not exist or has moved.
    </p>
    <div style="display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6)">
      <a class="button" href="/">Home</a>
      <a class="button button-ghost" href="/cv/">CV</a>
      <a class="button button-ghost" href="/publications/">Publications</a>
    </div>
  </div>
</BaseLayout>
