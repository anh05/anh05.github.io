---
/* Author: DA Nguyen */
// Open-source projects.
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description={`Open-source Python packages and research code by ${profile.name}: AutoML, Bayesian optimization and imbalanced classification.`}
>
  <h1>Projects</h1>
  <p class="muted">
    Open-source packages on <a href={profile.links.pypi.url} target="_blank" rel="noopener">PyPI</a> and
    code on <a href={profile.links.github.url} target="_blank" rel="noopener">GitHub</a>.
  </p>
  <div class="cards">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</BaseLayout>
