---
/* Author: DA Nguyen */
// All publications grouped by year, with DOI / code / package badges and BibTeX.
import { getCollection } from 'astro:content';
import PublicationItem from '../components/PublicationItem.astro';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = await getCollection('publications');
const byYear = Map.groupBy(publications, (pub) => pub.data.year);
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title="Publications"
  description={`Publications by ${profile.name} on AutoML, hyperparameter optimization and imbalanced classification.`}
>
  <h1>Publications</h1>
  <p class="muted">
    Also on <a href={profile.links.scholar.url} target="_blank" rel="noopener">Google Scholar</a>.
  </p>
  {
    years.map((year) => (
      <section class="year-group" aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`}>{year}</h2>
        {byYear.get(year)!.map((pub) => (
          <PublicationItem pub={pub} />
        ))}
      </section>
    ))
  }
</BaseLayout>
