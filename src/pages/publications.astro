---
// All publications grouped by year, with DOI / code / package badges and BibTeX.
// The type filter is pure CSS (radio inputs + :has()); without :has() support
// every publication simply stays visible.
import { getCollection } from 'astro:content';
import PublicationItem from '../components/PublicationItem.astro';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = await getCollection('publications');
const byYear = Map.groupBy(publications, (pub) => pub.data.year);
const years = [...byYear.keys()].sort((a, b) => b - a);

const count = (type?: string) => publications.filter((p) => !type || p.data.type === type).length;
const filters = [
  { id: 'all', label: 'All', n: count() },
  { id: 'journal', label: 'Journal', n: count('journal') },
  { id: 'conference', label: 'Conference', n: count('conference') },
  { id: 'thesis', label: 'Thesis', n: count('thesis') },
];
---

<BaseLayout
  title="Publications"
  description={`Publications by ${profile.name} on AutoML, hyperparameter optimization and imbalanced classification.`}
>
  <div class="container narrow page pubs-page">
    <header class="page-header">
      <h1>Publications</h1>
      <p class="lead muted">
        Research on AutoML, hyperparameter optimization and imbalanced classification. Also on <a
          href={profile.links.scholar.url}
          target="_blank"
          rel="noopener">Google Scholar</a
        >.
      </p>
    </header>

    <fieldset class="filter">
      <legend class="visually-hidden">Filter by publication type</legend>
      {
        filters.map((f) => (
          <>
            <input
              class="visually-hidden"
              type="radio"
              name="pub-type"
              id={`type-${f.id}`}
              value={f.id}
              checked={f.id === 'all'}
            />
            <label for={`type-${f.id}`}>
              {f.label} <span class="filter-count">{f.n}</span>
            </label>
          </>
        ))
      }
    </fieldset>

    {
      years.map((year) => (
        <section class="year-group" aria-labelledby={`y${year}`}>
          <h2 id={`y${year}`} class="year-title">
            {year}
          </h2>
          <div class="pub-list">
            {byYear.get(year)!.map((pub) => (
              <PublicationItem pub={pub} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-7);
    padding: 0;
    border: 0;
  }

  .filter label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
    color: var(--color-muted);
    cursor: pointer;
    user-select: none;
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }

  .filter label:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text-strong);
  }

  .filter-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .filter input:checked + label {
    border-color: var(--color-text-strong);
    background: var(--color-text-strong);
    color: var(--color-bg);
  }

  .filter input:focus-visible + label {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .year-group {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 40rem) {
    .year-group {
      grid-template-columns: 4.5rem 1fr;
    }
  }

  .year-title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.9;
    color: var(--color-muted);
  }

  /* Items in a year are separated by gaps, not borders, so filtering
     (display: none) never leaves a stray separator. */
  .year-group .pub-list {
    display: grid;
    gap: var(--space-6);
  }

  .year-group :global(.pub) {
    padding: 0;
    border: 0;
  }

  /* Filter: hide non-matching publications and years left empty. */
  .pubs-page:has(#type-journal:checked) :global(.pub:not([data-type='journal'])),
  .pubs-page:has(#type-conference:checked) :global(.pub:not([data-type='conference'])),
  .pubs-page:has(#type-thesis:checked) :global(.pub:not([data-type='thesis'])) {
    display: none;
  }

  .pubs-page:has(#type-journal:checked) .year-group:not(:has([data-type='journal'])),
  .pubs-page:has(#type-conference:checked) .year-group:not(:has([data-type='conference'])),
  .pubs-page:has(#type-thesis:checked) .year-group:not(:has([data-type='thesis'])) {
    display: none;
  }

  @media print {
    .filter {
      display: none;
    }
  }
</style>
